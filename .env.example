# Copialo a .env y cambia las claves. Lo leen docker compose y Estiba.

# WAHA: la API de WhatsApp (ver docker-compose.yml)
ESTIBA_WAHA_URL=http://127.0.0.1:3000
ESTIBA_WAHA_API_KEY=cambiame-por-algo-largo-y-al-azar
# Firma de los webhooks (HMAC-SHA512). Opcional, recomendado.
ESTIBA_WAHA_HMAC=cambiame-tambien
# Como llega WAHA, desde Docker, a Estiba (el puerto de `estiba serve`)
ESTIBA_URL_PARA_WAHA=http://host.docker.internal:8001

# Clave del dashboard, obligatoria si lo abris a la red (--host 0.0.0.0)
# ESTIBA_CLAVE=

# Espejo de la agenda en un CalDAV (opcional)
# ESTIBA_CALDAV_URL=http://localhost:5232/fletero/fletes/
# ESTIBA_CALDAV_USUARIO=
# ESTIBA_CALDAV_CLAVE=
